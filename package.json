{
  "name": "zedge",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 4188",
    "build": "tsc -b && vite build",
    "preview": "vite preview --host 127.0.0.1 --port 4188",
    "lint": "oxlint --deny-warnings src server api",
    "test": "node --experimental-strip-types --test src/lib/market.test.ts src/chain/*.test.ts src/chain/private/*.test.ts server/*.test.ts",
    "check": "npm run lint && npm test && npm run build && npm run check:dist",
    "check:dist": "! grep -rlE 'ZEDGE-FORK-ONLY|127\\.0\\.0\\.1:(38945|39301)' dist",
    "test:engine": "cd engine && go test -race ./... && go vet ./...",
    "test:keeper": "node --test services/keeper/*.test.mjs",
    "test:contracts": "cd contracts && forge test",
    "test:crypto": "npm --prefix adapters/vela/crypto run check && npm --prefix adapters/vela/crypto test",
    "test:protocol": "node scripts/verify-protocol.mjs"
  },
  "dependencies": {
    "@fontsource-variable/manrope": "^5.2.8",
    "@fontsource/ibm-plex-mono": "^5.2.7",
    "@horizen/vela-common-ts": "0.2.0",
    "@phosphor-icons/react": "^2.1.10",
    "@privy-io/react-auth": "3.48.0",
    "@stripe/stripe-js": "1.54.2",
    "@tanstack/react-query": "5.104.1",
    "@upstash/redis": "1.39.0",
    "ethers": "6.17.0",
    "jose": "6.2.12",
    "lightweight-charts": "5.2.1",
    "postgres": "3.4.9",
    "qrcode": "1.5.4",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "viem": "2.57.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/qrcode": "1.5.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  },
  "overrides": {
    "@solana/kit": "8.4.0",
    "ws": "8.22.0",
    "uuid": "11.1.1",
    "decode-uri-component": "0.5.0"
  }
}
