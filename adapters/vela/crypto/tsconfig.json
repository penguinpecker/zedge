{
  "compilerOptions": {
    "target": "ES2023", "lib": ["ES2023", "DOM"], "module": "ESNext",
    "moduleResolution": "bundler", "strict": true, "noEmit": true,
    "allowImportingTsExtensions": true, "skipLibCheck": true,
    "verbatimModuleSyntax": true, "erasableSyntaxOnly": true
  },
  "include": ["*.ts"]
}
